generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                    String        @id @default(cuid())
  name                  String
  email                 String        @unique
  passwordHash          String
  emailRemindersEnabled Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  applications          Application[]
  reminders             Reminder[]

  @@index([email])
}

model Application {
  id              String           @id @default(cuid())
  userId          String
  companyName     String
  jobTitle        String
  jobType         String           @default("Internship")
  workMode        String           @default("On-site")
  location        String?
  compensation    String?
  applicationUrl  String?
  applicationDate DateTime         @default(now())
  deadline        DateTime?
  status          String           @default("Wishlist")
  priority        String           @default("Medium")
  recruiterName   String?
  recruiterEmail  String?
  description     String?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  interviews      InterviewRound[]
  reminders       Reminder[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, deadline])
}

model InterviewRound {
  id                 String     @id @default(cuid())
  applicationId      String
  roundName          String
  interviewType      String
  scheduledAt        DateTime
  meetingLink        String?
  location           String?
  interviewerDetails String?
  status             String     @default("Upcoming")
  preparationNotes   String?
  feedback           String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  application        Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reminders          Reminder[]

  @@index([applicationId])
  @@index([scheduledAt])
}

model Reminder {
  id               String          @id @default(cuid())
  userId           String
  applicationId    String
  interviewRoundId String?
  reminderType     String
  title            String?
  scheduledAt      DateTime
  deliveryStatus   String          @default("PENDING")
  sentAt           DateTime?
  createdAt        DateTime        @default(now())

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  application      Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewRound   InterviewRound? @relation(fields: [interviewRoundId], references: [id], onDelete: Cascade)

  @@index([userId, deliveryStatus, scheduledAt])
  @@index([applicationId, reminderType])
  @@index([interviewRoundId, reminderType])
}
