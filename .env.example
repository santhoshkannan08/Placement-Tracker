# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database (Prisma)
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/placetrack?schema=public"

# JWT Authentication
JWT_SECRET="replace-with-a-long-random-secret-key-min-32-chars"
JWT_EXPIRES_IN="7d"

# Cookie & CSRF Configuration
COOKIE_SECRET="replace-with-another-random-secret-key"

# Email / SMTP Configuration (Nodemailer)
# Set EMAIL_DEV_MODE=true to preview/log emails in console without sending real emails
EMAIL_DEV_MODE=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="PlaceTrack <noreply@placetrack.local>"
